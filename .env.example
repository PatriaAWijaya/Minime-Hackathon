# Variable names only — never put a real key in this file or in the repo.
# Meta Model API (primary, Muse for ALL agents)
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
# Provisional default model; the exact variant on Patria's account is confirmed
# at the Phase 0 gate and recorded in CostRecord. Do not treat this as verified.
META_MODEL=muse-spark-1.1
# Gemini via Google API (fallback 1, and QC for Muse output)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# DeepSeek via Ollama (fallback 2, local; on Patria's MacBook, NOT in this VM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1
# CostLedger hard limit, in the ledger's cost units (USD). 0 disables the limit
# only in local mock runs; production runs must set a positive limit.
COST_HARD_LIMIT_USD=5
